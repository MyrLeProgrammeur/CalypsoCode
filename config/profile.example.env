# calypsocode compartment profile — example
#
# Copy to ~/.config/calypsocode/profiles/<name>.env and edit. The name of the
# file is the name you pass to --profile; with no flag, `default` is used.
#
#   cp config/profile.example.env ~/.config/calypsocode/profiles/default.env
#
# Or let the launcher ask the questions and write the file for you:
#
#   calypsocode --new-profile default
#   calypsocode --new-profile client-acme --from default
#
# One launch = one namespace = one circuit = one key = one config. A compartment
# is only as isolated as its weakest shared signal, so do not reuse an API key,
# a git identity, or a config directory across two profiles.
# See docs/DESIGN.md#the-rule-for-compartments.
#
# Format: KEY=value, one per line. `#` starts a comment. No shell expansion is
# performed — this file is parsed, never sourced, so `$HOME` and `$(cmd)` are
# literal text.

# Compartment name. Appears in the receipt. Defaults to the filename.
PROFILE=client-acme

# Network backend. v1 accepts `tor` and `none` only.
#   tor  — oniux, fail-closed at the kernel routing table
#   none — no isolation at all; the launcher warns loudly
NETWORK=tor

# Name of the environment variable holding this compartment's API key.
# The key itself is NOT stored here: this file sits in your config directory
# and would end up in backups and dotfile repos. Export the key from your
# password manager instead, e.g.
#   set -x VENICE_API_KEY_ACME (pass show venice/acme)
API_KEY_ENV=VENICE_API_KEY_ACME

# OpenAI-compatible endpoint this compartment talks to.
API_BASE=https://api.venice.ai/api/v1

# Model the session opens on. Model choice is yours — including an uncensored
# one. What a provider can read is a property of the provider, not of this tool:
# see docs/THREAT-MODEL.md#reading-a-providers-privacy-claims before picking.
MODEL=e2ee-deepseek-v4-flash

# Optional. Extra models offered to the agent's own in-session picker, so you
# can switch without editing this file. Comma- or space-separated. MODEL stays
# the default. Listing only one is fine — that is the same as omitting this.
MODELS=e2ee-qwen3-6-27b, e2ee-qwen3-6-35b-a3b

# Git identity used inside the namespace. Neutral by default: git otherwise
# prints your real name into every commit the agent makes.
GIT_NAME=dev
GIT_EMAIL=dev@localhost
