#!/usr/bin/env bash
# calypsocode — run a coding agent under a compartment identity.
#
# CalypsoCode hides your network identity from everyone except the provider you
# pay. Nothing here inspects or modifies traffic: every identifier is removed
# before the agent starts, by controlling the environment it runs in.
#
# Design: docs/DESIGN.md · Verified stack behaviour: docs/FINDINGS.md
set -euo pipefail

# Resolved before anything is exported: XDG_CONFIG_HOME is rewritten later to
# point the agent at the compartment, and these paths must not follow it.
CALYPSO_HOME="${CALYPSO_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/calypsocode}"
PROFILE_DIR="${CALYPSO_PROFILE_DIR:-$CALYPSO_HOME/profiles}"
# Receipts go here and never to /tmp: oniux gives the child a private /tmp, so
# anything written there is invisible from the host (docs/FINDINGS.md F6/F7).
STATE_DIR="${CALYPSO_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/calypsocode}"

# Keys accepted in a profile file. Anything else is a typo and is refused.
# MODELS is optional: extra models to offer the agent's own picker, beyond
# MODEL. MODEL stays the default the session opens with.
PROFILE_KEYS=(PROFILE NETWORK API_KEY_ENV API_BASE MODEL MODELS GIT_NAME GIT_EMAIL)
PROFILE_REQUIRED=(NETWORK API_KEY_ENV API_BASE MODEL GIT_NAME GIT_EMAIL)

# Filled by profile_load via `printf -v`, one per key above. Declared here so
# their origin is visible at the top of the file rather than only inside the
# parser.
P_PROFILE=""
P_NETWORK=""
P_API_KEY_ENV=""
P_API_BASE=""
P_MODEL=""
P_MODELS=""
P_GIT_NAME=""
P_GIT_EMAIL=""

PROFILE_FILE=""
COMPARTMENT_DIR=""
OPENCODE_CONFIG_FILE=""

die() { echo "calypsocode: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
calypsocode — run a coding agent under a compartment identity.

usage:
  calypsocode [--profile NAME] [agent args...]
  calypsocode profile [--profile NAME]
  calypsocode doctor
  calypsocode --help

options:
  --profile NAME   compartment to launch (default: default). Resolved to
                   ~/.config/calypsocode/profiles/NAME.env
  --no-verify      skip the egress check AND the leak test. Both cost a few
                   seconds; skipping them means the session runs with no
                   evidence that it is isolated, and the receipt says so.
  -y, --yes        do not wait for confirmation of the startup check
  --force-unsafe   launch even though the leak test found the LAN reachable
                   from inside the namespace. For debugging isolation, never
                   for work. Command line only — deliberately not settable
                   from a profile or the environment, so it cannot become
                   somebody's silent default.

commands:
  profile          print the resolved profile and exit
  doctor           report what is and is not ready, without launching

environment:
  CALYPSO_NETWORK  override the profile's NETWORK for one run. `none` disables
                   isolation entirely and is warned about on every launch.

One launch is one namespace and one circuit. One compartment is one key, one
config and one identity, persisting across launches. Nothing crosses between
compartments — see docs/DESIGN.md.
EOF
}

# --- profile loading -------------------------------------------------------

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

profile_key_known() {
  local k
  for k in "${PROFILE_KEYS[@]}"; do
    if [ "$k" = "$1" ]; then return 0; fi
  done
  return 1
}

# What the picker can honestly say about a backend before anything has run.
# Never "working": that would need a round trip, and a green light earned by the
# presence of a binary is the mistake the first doctor made. The most this can
# report is that the pieces are in place.
backend_state() {
  case "$1" in
    tor)
      if command -v oniux >/dev/null 2>&1; then
        echo "oniux installed, not yet verified"
      else
        echo "UNAVAILABLE — oniux is not installed"
      fi
      ;;
    none) echo "available — and offers nothing" ;;
    *) echo "not built yet" ;;
  esac
}

# Shown once, when there is no profile to load. Everything it asks goes into a
# profile file and nowhere else: a remembered choice living somewhere other than
# the profile is how a profile that says `tor` ends up running something else.
profile_create() {
  local name="$1"
  local answer network api_base model key_env git_name git_email compartment

  echo "No profile named '$name' yet. Let's make one."
  echo "It will be written to $PROFILE_DIR/$name.env and read on every launch."
  echo
  echo "Network backend. This decides who can see that you are talking to a"
  echo "provider at all. It has no effect on what the provider itself can read —"
  echo "that is a property of the provider you choose, not of this tool."
  echo
  echo "  1) tor     Traffic leaves through Tor. The provider sees a Tor exit"
  echo "             instead of your address; your ISP sees only that you use Tor."
  echo "             [$(backend_state tor)]"
  echo "  2) none    No isolation whatsoever. Your real address reaches the"
  echo "             provider. For testing the rest of the compartment."
  echo "             [$(backend_state none)]"
  echo "  3) vpn     WireGuard inside the namespace. [$(backend_state vpn)]"
  echo "  4) direct  Plain namespace, no anonymity. [$(backend_state direct)]"
  echo "  5) socks   A SOCKS endpoint you run yourself. [$(backend_state socks)]"
  echo "             Note for later: this is not \"Tor but faster\". Whatever"
  echo "             anonymity it gives is a property of the endpoint you supply."
  echo

  network=""
  while [ -z "$network" ]; do
    printf 'Backend [1]: '
    read -r answer || true
    case "${answer:-1}" in
      1 | tor)
        command -v oniux >/dev/null 2>&1 \
          || { echo "  oniux is not installed — cargo install --git https://gitlab.torproject.org/tpo/core/oniux"; continue; }
        network="tor"
        ;;
      2 | none) network="none" ;;
      3 | 4 | 5 | vpn | direct | socks)
        echo "  Not built yet — see docs/ROADMAP.md. Pick 1 or 2."
        ;;
      *) echo "  Not one of the options." ;;
    esac
  done

  echo
  echo "Your provider. Calypso does not recommend one and never sends anything"
  echo "on your behalf — it only points the agent at what you choose."
  printf 'API base URL (OpenAI-compatible): '
  read -r api_base || true
  [ -n "$api_base" ] || die "an API base URL is required."
  printf 'Model: '
  read -r model || true
  [ -n "$model" ] || die "a model is required."

  printf 'Name of the environment variable holding your key [CALYPSO_API_KEY]: '
  read -r key_env || true
  key_env="${key_env:-CALYPSO_API_KEY}"

  printf 'Compartment name [%s]: ' "$name"
  read -r compartment || true
  compartment="${compartment:-$name}"

  printf 'Git author name for this compartment [dev]: '
  read -r git_name || true
  git_name="${git_name:-dev}"
  printf 'Git author email [dev@localhost]: '
  read -r git_email || true
  git_email="${git_email:-dev@localhost}"

  mkdir -p "$PROFILE_DIR"
  umask 077
  cat > "$PROFILE_FILE" <<EOF
# Written by \`calypsocode\` on $(date -u +%Y-%m-%d). Edit freely.
PROFILE=$compartment
NETWORK=$network
API_KEY_ENV=$key_env
API_BASE=$api_base
MODEL=$model
GIT_NAME=$git_name
GIT_EMAIL=$git_email
EOF

  echo
  echo "Written: $PROFILE_FILE"
  if [ "$network" = "none" ]; then
    echo "Reminder: NETWORK=none means no isolation at all."
  fi
  echo "Your key is never stored here — only the name of the variable holding it."
  echo
}

# Parses KEY=value lines into P_<KEY> shell variables. The file is read, never
# sourced: a profile lives in a config directory and must not be able to run
# code.
profile_load() {
  local name="$1"
  PROFILE_FILE="$PROFILE_DIR/$name.env"

  # No profile and someone to ask: offer to build one. With --yes, or without a
  # terminal, refuse instead — picking a backend on the user's behalf is exactly
  # the silent default this tool exists to avoid.
  if [ ! -f "$PROFILE_FILE" ] \
    && [ -z "$COMMAND" ] && [ "$ASSUME_YES" != "1" ] && [ -t 0 ]; then
    profile_create "$name"
  fi

  if [ ! -f "$PROFILE_FILE" ]; then
    die "profile '$name' not found: $PROFILE_FILE
  → run 'calypsocode' with a terminal and it will offer to create one,
    or copy config/profile.example.env to that path and edit it,
    or select another profile with --profile NAME."
  fi

  local lineno=0 line key value var
  local -a seen_keys=()
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    line="${line%$'\r'}"
    line="$(trim "$line")"
    case "$line" in
      '' | '#'*) continue ;;
      *=*) ;;
      *) die "$PROFILE_FILE:$lineno: not a KEY=value line: $line" ;;
    esac

    key="$(trim "${line%%=*}")"
    value="$(trim "${line#*=}")"
    case "$value" in
      \"*\") value="${value#\"}"; value="${value%\"}" ;;
      \'*\') value="${value#\'}"; value="${value%\'}" ;;
    esac

    if ! profile_key_known "$key"; then
      die "$PROFILE_FILE:$lineno: unknown key '$key' (accepted: ${PROFILE_KEYS[*]})"
    fi
    # Same reason unknown keys are refused: a duplicate resolves silently to the
    # last one, and a second NETWORK= line would drop a compartment boundary
    # without a word.
    case " ${seen_keys[*]:-} " in
      *" $key "*) die "$PROFILE_FILE:$lineno: '$key' set twice — refusing rather than picking one" ;;
    esac
    seen_keys+=("$key")
    printf -v "P_$key" '%s' "$value"
  done < "$PROFILE_FILE"

  for key in "${PROFILE_REQUIRED[@]}"; do
    var="P_$key"
    if [ -z "${!var:-}" ]; then
      die "$PROFILE_FILE: missing required key '$key'"
    fi
  done

  : "${P_PROFILE:=$name}"

  # PROFILE names a directory under $CALYPSO_HOME/compartments. A slash or a `..`
  # walks out of it: two profiles both saying `../shared` resolve to one directory,
  # sharing config, data and state — the F9 failure this launcher was rewritten to
  # prevent, reachable by typing a profile name. A slash alone is worse than useless,
  # because the agent still runs and the receipt path is then unwritable, so a session
  # sends data and leaves no record of it. Validated after the filename default is
  # applied, because `--profile a/b` gets here too.
  case "$P_PROFILE" in
    *[!A-Za-z0-9._-]* | '' | .* )
      die "$PROFILE_FILE: PROFILE='$P_PROFILE' — letters, digits, dot, underscore and
  hyphen only, and not starting with a dot. It names a directory, so a slash or '..'
  would place this compartment outside the others." ;;
  esac

  case "$P_NETWORK" in
    tor | none) ;;
    *) die "$PROFILE_FILE: NETWORK='$P_NETWORK' — v1 accepts 'tor' or 'none'" ;;
  esac
}

profile_show() {
  echo "profile:      $P_PROFILE"
  echo "file:         $PROFILE_FILE"
  echo "network:      $P_NETWORK"
  echo "api_base:     $P_API_BASE"
  echo "model:        $P_MODEL"
  if [ -n "$P_MODELS" ]; then
    echo "also offered: $(model_list | tail -n +2 | paste -sd , - | sed 's/,/, /g')"
  fi
  echo "git identity: $P_GIT_NAME <$P_GIT_EMAIL>"
  if [ -n "${!P_API_KEY_ENV:-}" ]; then
    echo "api key:      \$$P_API_KEY_ENV is set"
  else
    echo "api key:      \$$P_API_KEY_ENV is NOT set in this shell"
  fi
}

# --- compartment -----------------------------------------------------------

# The models this compartment offers, MODEL first, one per line, de-duplicated.
# Commas and whitespace both separate: a profile is hand-edited and both will
# get typed. MODEL leads because the agent opens on the first entry.
model_list() {
  local -a words seen=()
  local m
  read -ra words <<< "$P_MODEL ${P_MODELS//,/ }"
  for m in "${words[@]}"; do
    [ -n "$m" ] || continue
    case " ${seen[*]:-} " in *" $m "*) continue ;; esac
    seen+=("$m")
    printf '%s\n' "$m"
  done
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# The agent config Calypso derives from the profile. Regenerated on every
# launch, because it must always match the profile it claims to implement.
# Anything the user wants to add for this compartment goes in
# $COMPARTMENT_DIR/calypsocode-agent/opencode.json, which is never written
# here (the agent's own per-app config directory follows its `app` constant —
# calypsocode-agent — the on-disk file name it looks for there is unchanged).
compartment_prepare() {
  COMPARTMENT_DIR="$CALYPSO_HOME/compartments/$P_PROFILE"
  OPENCODE_CONFIG_FILE="$COMPARTMENT_DIR/opencode.calypso.json"

  mkdir -p "$COMPARTMENT_DIR/calypsocode-agent" "$COMPARTMENT_DIR/data" "$COMPARTMENT_DIR/state"

  local base model key_env models_json m
  base="$(json_escape "$P_API_BASE")"
  model="$(json_escape "$P_MODEL")"
  key_env="$(json_escape "$P_API_KEY_ENV")"

  models_json=""
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    [ -z "$models_json" ] || models_json+=","$'\n'
    models_json+="        \"$(json_escape "$m")\": {}"
  done < <(model_list)

  cat > "$OPENCODE_CONFIG_FILE" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "calypsocode/$model",
  "autoupdate": false,
  "provider": {
    "calypsocode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "$(json_escape "$P_PROFILE") (calypsocode compartment)",
      "options": {
        "baseURL": "$base",
        "apiKey": "{env:$key_env}"
      },
      "models": {
$models_json
      }
    }
  }
}
EOF
}

# --- startup check and receipt ---------------------------------------------
# One check at the boundary, then silence, then the receipt. No per-request
# warnings — see docs/DESIGN.md#the-receipt.

SESSION_STARTED=0
SESSION_START_EPOCH=0
SESSION_START_STAMP=""
EGRESS_FILE=""
STARTED_FILE=""
LEAK_FILE=""
RECEIPT_DONE=0

os_username() { id -un; }

# Private addresses the namespace must NOT be able to reach. They are collected
# out here because they are invisible from inside — the namespace has one route
# and knows nothing of the host's interfaces.
#
# 169.254.42.0/24 is excluded on purpose: that is onion0's own subnet, and
# 169.254.42.53 is Tor's resolver. Both are legitimately reachable, and testing
# them would fail every session (docs/FINDINGS.md F10).
# Finding nothing is a valid answer here — it is the inner script's job to
# refuse on an empty list, with a message that says why. So every stage is kept
# from failing the function: under `set -o pipefail` a filter that matches
# nothing, or a missing `ip`, would otherwise abort the launcher before it ever
# reached the namespace.
# One TCP probe, three outcomes, because the verdict depends on telling them apart:
#   0 — the handshake completed. Whatever came back, the packet arrived.
#   1 — refused. This is the only outcome that proves isolation.
#   2 — timed out. Proves nothing either way, and must not be read as a pass.
#
# `curl` rather than bash's `/dev/tcp`: the test suite can stub a command and cannot
# stub a builtin redirection, and a check that cannot be tested is how this one got
# broken in the first place. Correctness does not depend on HTTP — a port accepting
# TCP without speaking HTTP returns 52 or 56, and both mean the connection was made.
probe_tcp() {
  local rc=0
  (
    unset ALL_PROXY all_proxy HTTP_PROXY http_proxy HTTPS_PROXY https_proxy
    curl -s --noproxy '*' -o /dev/null --max-time "${2:-5}" "http://$1/"
  ) 2>/dev/null || rc=$?
  case "$rc" in
    0 | 52 | 56) return 0 ;;
    28) return 2 ;;
    *) return 1 ;;
  esac
}

# Candidate targets, as address:port. Ports matter: the previous version probed
# port 80 only, so a target with nothing listening there answered the same way
# whether the namespace was sealed or wide open, and two of three targets on a
# typical host were therefore decorative.
leak_candidates() {
  local gw a p
  gw="$(ip route 2>/dev/null | awk '/^default/ && $3 ~ /^[0-9]/ { print $3 }' | head -1 || true)"
  if [ -n "$gw" ]; then
    printf '%s:80\n%s:443\n' "$gw" "$gw"
  fi
  # Only listeners bound to every interface: one bound to 127.0.0.1 is not
  # reachable from another namespace even without isolation, so it would prove
  # nothing either.
  while read -r p; do
    [ -n "$p" ] || continue
    while read -r a; do
      [ -n "$a" ] || continue
      printf '%s:%s\n' "$a" "$p"
    done < <(ip -4 -o addr show scope global 2>/dev/null | awk '{ print $4 }' | cut -d/ -f1 | awk '!/^169\.254\.42\./' || true)
  done < <(ss -ltn 2>/dev/null | awk 'NR > 1 { print $4 }' | grep -E '^(\*|0\.0\.0\.0|\[::\]):' | sed 's/.*://' | sort -u || true)
}

# Only candidates the host itself can reach are evidence. Confirming from outside
# the namespace is the whole point: if the host cannot reach it either, the
# namespace failing to reach it says nothing at all.
leak_targets() {
  local hp
  while read -r hp; do
    [ -n "$hp" ] || continue
    if probe_tcp "$hp" 3; then printf '%s\n' "$hp"; fi
  done < <(leak_candidates | sort -u) || true
}

# The neutral account names THREAT-MODEL.md documents. If the username IS the
# convention, then finding it in a path is the recommended state and not a leak:
# warning about it would train the reader to ignore the line, which is the line
# that matters on the day the path really does carry their name.
NEUTRAL_USERNAMES=(user dev)

# The path leak Calypso does not fix. Convention handles it; the receipt states
# it. See docs/THREAT-MODEL.md#keep-your-username-out-of-your-paths.
path_leaks_username() {
  local user u
  user="$(os_username)"
  for u in "${NEUTRAL_USERNAMES[@]}"; do
    if [ "$user" = "$u" ]; then return 1; fi
  done
  case "$PWD" in
    *"$user"*) return 0 ;;
    *) return 1 ;;
  esac
}

# Counts sessions per compartment and reports the total. Deliberately not
# rotation: minting a fresh key on the same account changes nothing the provider
# sees, because every key resolves to the same customer. What accumulates is
# history on one account, and the only thing the launcher can honestly do about
# it is make it visible. Called once a session has actually happened, so a
# refused launch never counts.
#
# Only ever called from receipt_write, which shellcheck already cannot see is
# invoked (it runs from the EXIT, INT and TERM traps), so this looks unused too.
# shellcheck disable=SC2329
session_tally() {
  local file count since
  file="$STATE_DIR/sessions-$P_PROFILE"
  count=0
  since=""
  if [ -f "$file" ]; then
    read -r count since < "$file" || true
  fi
  case "$count" in
    '' | *[!0-9]*) count=0 ;;
  esac
  [ -n "$since" ] || since="$(date -u +%Y-%m-%d)"
  count=$((count + 1))
  printf '%s %s\n' "$count" "$since" > "$file"
  printf '%s %s\n' "$count" "$since"
}

startup_check() {
  local user
  user="$(os_username)"

  echo "calypsocode: compartment '$P_PROFILE'"
  echo "  git identity   $P_GIT_NAME <$P_GIT_EMAIL>"
  echo "  account        \$$P_API_KEY_ENV at $P_API_BASE"
  echo "                 the provider knows which customer this is — it is what you pay with"
  if [ "$NETWORK" = "tor" ]; then
    if [ "$VERIFY" = "1" ]; then
      # Future tense on purpose. This prints before the confirmation prompt, and the
      # egress check runs after it — saying "verified" here would assert an
      # accomplished fact to get consent for the thing that establishes it.
      echo "  network        tor — egress will be verified from inside the namespace"
      echo "                 before the agent starts, and the receipt will name the exit"
    else
      echo "  network        tor, NOT verified (--no-verify)"
    fi
  else
    echo "  network        none — no isolation, your real IP reaches the provider"
  fi
  if path_leaks_username; then
    echo "  project path   $PWD"
    echo "                 contains your OS username '$user' — the agent will read and send it"
  else
    echo "  project path   $PWD — nothing identifying in it"
  fi

  if [ "$ASSUME_YES" = "1" ]; then
    return 0
  fi
  if [ ! -t 0 ]; then
    die "not a terminal, so the check above cannot be confirmed — pass --yes to proceed."
  fi

  local answer=""
  printf 'Launch this compartment? [y/N] '
  read -r answer || true
  case "$answer" in
    y | Y | yes | YES) return 0 ;;
    *) die "aborted." ;;
  esac
}

# Invoked from the EXIT, INT and TERM traps, which shellcheck cannot see.
# Both codes: older shellcheck reports the body as unreachable (SC2317), newer
# reports the function as uninvoked (SC2329).
# shellcheck disable=SC2317,SC2329
receipt_write() {
  local status=$?
  [ "$SESSION_STARTED" = "1" ] || return "$status"
  # Ctrl-C runs this from the signal trap and then again from the EXIT trap.
  if [ "$RECEIPT_DONE" = "1" ]; then return "$status"; fi
  RECEIPT_DONE=1

  local end_epoch end_stamp elapsed exit_ip user receipt started=0 leak="" leak_body=""

  exit_ip=""
  if [ -n "$EGRESS_FILE" ] && [ -f "$EGRESS_FILE" ]; then
    read -r exit_ip < "$EGRESS_FILE" || true
    rm -f "$EGRESS_FILE"
  fi
  if [ -n "$LEAK_FILE" ] && [ -f "$LEAK_FILE" ]; then
    read -r leak < "$LEAK_FILE" || true
    rm -f "$LEAK_FILE"
  fi
  if [ -n "$STARTED_FILE" ] && [ -f "$STARTED_FILE" ]; then
    started=1
    rm -f "$STARTED_FILE"
  fi

  # A refused launch is not a session. Saying what "was not removed" when
  # nothing was sent would be a receipt for something that never happened.
  if [ "$started" != "1" ]; then
    rm -f "$LEAK_FILE"
    echo "calypsocode: the agent never started — nothing was sent, so no receipt." >&2
    return "$status"
  fi

  end_epoch="$(date -u +%s)"
  end_stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  elapsed=$((end_epoch - SESSION_START_EPOCH))
  user="$(os_username)"
  local tally session_no session_since
  tally="$(session_tally)"
  session_no="${tally%% *}"
  session_since="${tally#* }"

  mkdir -p "$STATE_DIR"
  receipt="$STATE_DIR/receipt-$(date -u +%Y%m%dT%H%M%SZ)-$P_PROFILE.txt"

  {
    echo "calypsocode receipt"
    echo
    echo "compartment:  $P_PROFILE"
    if [ "$NETWORK" = "none" ]; then
      echo "network:      none — no isolation. Your real IP reached $P_API_BASE."
    elif [ -n "$exit_ip" ]; then
      echo "network:      tor, exit $exit_ip, verified IsTor before launch"
    elif [ "$VERIFY" = "1" ]; then
      echo "network:      tor, but the egress check did not complete — unverified"
    else
      echo "network:      tor, egress NOT verified (--no-verify)"
    fi
    case "$leak" in
      passed*)
        # Says what was proved, not how many things were tried. Each target here
        # answered a TCP connect from the host and refused one from inside the
        # namespace; that difference is the evidence. The round-trip times are the
        # corroboration — a refusal at the kernel's own closed port comes back in
        # well under a millisecond, while one refused after leaving through onion0
        # takes hundreds.
        leak_body="${leak#passed }"
        echo "isolation:    leak test passed — ${leak_body%%|*} target(s) reachable from"
        echo "              the host refused the connection from inside the namespace"
        if [ "${leak_body#*|}" != "${leak_body%%|*}" ] && [ -n "${leak_body#*|}" ]; then
          echo "              refusal times: ${leak_body#*|}"
        fi
        ;;
      inconclusive*)
        echo "isolation:    leak test INCONCLUSIVE —${leak#inconclusive} timed out"
        echo "              rather than refusing. Launched anyway with --force-unsafe."
        echo "              Isolation was neither proved nor disproved this session."
        ;;
      forced*)
        echo "isolation:    LEAK —${leak#forced} answered from inside the namespace."
        echo "              Launched anyway with --force-unsafe. This session was"
        echo "              NOT isolated from your own network."
        ;;
      *)
        if [ "$VERIFY" = "1" ]; then
          echo "isolation:    leak test did not complete — isolation unproven"
        else
          echo "isolation:    leak test NOT RUN (--no-verify) — isolation unproven"
        fi
        ;;
    esac
    echo "identity:     git $P_GIT_NAME <$P_GIT_EMAIL>, TZ=UTC, LC_ALL=C"
    echo "config:       compartment-local only ($COMPARTMENT_DIR)"
    echo "session:      $SESSION_START_STAMP – $end_stamp (${elapsed}s)"
    echo
    echo "NOT removed:  prompt content, source code, writing style"
    echo "              session timing — the times above are what the provider saw"
    if path_leaks_username; then
      echo "              OS username '$user' is in your project path ($PWD)"
    fi
    echo "              account: \$$P_API_KEY_ENV at $P_API_BASE — the provider"
    echo "                       knows which paying customer this was"
    echo "                       session $session_no in this compartment since"
    echo "                       $session_since, all of them on that account"
    echo
    echo "Calypso is not in the request path, so this states session facts, not"
    echo "contents. It cannot count requests or tell you what was sent — by design:"
    echo "reading your traffic to report on it is the thing it refuses to do."
  } > "$receipt"

  cat "$receipt" >&2
  echo >&2
  echo "calypsocode: receipt written to $receipt" >&2

  return "$status"
}

# --- doctor ----------------------------------------------------------------
# Reports what it checked and what it could not check. It does not conclude
# that the tool works: three binaries existing proves nothing, and saying
# otherwise is what the previous version did wrong.

doctor_bin() {
  local name="$1" hint="$2"
  if command -v "$name" >/dev/null 2>&1; then
    echo "  ok    $name — $(command -v "$name")"
    return 0
  fi
  echo "  FAIL  $name not found — $hint"
  return 1
}

# `oniux --version` does not exist, so the revision comes from cargo's own install
# registry. It matters: every isolation finding in docs/FINDINGS.md was measured
# against one revision of an experimental tool, and without knowing which, none of
# them is reproducible — including by their author, after the next `cargo install`.
oniux_revision() {
  local reg="${CARGO_HOME:-$HOME/.cargo}/.crates2.json"
  [ -f "$reg" ] || return 1
  python3 - "$reg" <<'PY' 2>/dev/null || return 1
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
for key in data.get("installs", {}):
    if key.startswith("oniux "):
        print(key)
        break
else:
    raise SystemExit(1)
PY
}

doctor() {
  local failed=0 rev

  echo "checked, on this host:"
  if [ "$P_NETWORK" = "none" ]; then
    echo "  n/a   oniux — this profile is NETWORK=none, so nothing isolates it"
  else
    if doctor_bin oniux "cargo install --git https://gitlab.torproject.org/tpo/core/oniux --tag v0.11.0"; then
      if rev="$(oniux_revision)"; then
        echo "        $rev"
      else
        echo "        version unknown — cargo's install registry did not name it, so the"
        echo "        findings in docs/FINDINGS.md cannot be tied to what is installed"
      fi
    else
      failed=1
    fi
  fi
  # Both the leak test and the egress check are curl. Its absence is otherwise
  # discovered after the user has already confirmed a launch.
  doctor_bin curl     "install it with your package manager" || failed=1
  doctor_bin calypsocode-agent "build it: github.com/MyrLeProgrammeur/calypsocode-agent" || failed=1

  if [ -f "$PROFILE_FILE" ]; then
    echo "  ok    profile '$P_PROFILE' parsed — $PROFILE_FILE"
  fi

  if [ -n "${!P_API_KEY_ENV:-}" ]; then
    echo "  ok    \$$P_API_KEY_ENV is set"
  else
    echo "  FAIL  \$$P_API_KEY_ENV is not set in this shell"
    failed=1
  fi

  echo
  echo "not checked:"
  echo "  egress is Tor — verified from inside the namespace at launch, not here"
  echo "  the provider accepts this key over Tor — untested, see docs/FINDINGS.md"

  echo
  if [ "$failed" = 0 ]; then
    echo "calypsocode: nothing above failed. That is not the same as working —"
    echo "the network claims are verified at launch, not by this command."
  else
    echo "calypsocode: fix the FAIL lines above." >&2
  fi
  return "$failed"
}

# --- argument parsing ------------------------------------------------------

PROFILE_NAME="default"
COMMAND=""
VERIFY=1
ASSUME_YES=0
# Read from argv and nowhere else. It is exported unconditionally below, so a
# CALYPSO_FORCE_UNSAFE already in the environment is overwritten rather than
# obeyed — the flag cannot become a silent default.
FORCE_UNSAFE=0
AGENT_ARGS=()

case "${1:-}" in
  doctor | profile)
    COMMAND="$1"
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --profile)
      [ $# -ge 2 ] || die "--profile needs a name"
      PROFILE_NAME="$2"
      shift 2
      ;;
    --profile=*)
      PROFILE_NAME="${1#--profile=}"
      shift
      ;;
    --no-verify)
      VERIFY=0
      shift
      ;;
    --force-unsafe)
      FORCE_UNSAFE=1
      shift
      ;;
    -y | --yes)
      ASSUME_YES=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      AGENT_ARGS+=("$@")
      break
      ;;
    *)
      AGENT_ARGS+=("$1")
      shift
      ;;
  esac
done

if [ -n "$COMMAND" ] && [ ${#AGENT_ARGS[@]} -gt 0 ]; then
  die "$COMMAND takes no arguments other than --profile"
fi

profile_load "$PROFILE_NAME"

case "$COMMAND" in
  profile)
    profile_show
    exit 0
    ;;
  doctor)
    doctor
    exit $?
    ;;
esac

# --- launch ----------------------------------------------------------------

NETWORK="${CALYPSO_NETWORK:-$P_NETWORK}"
case "$NETWORK" in
  tor | none) ;;
  *) die "CALYPSO_NETWORK='$NETWORK' — accepted values: tor, none" ;;
esac

API_KEY_VALUE="${!P_API_KEY_ENV:-}"
if [ -z "$API_KEY_VALUE" ]; then
  die "\$$P_API_KEY_ENV is empty or unset — this compartment has no key.
  Export it from wherever you keep secrets, then run again."
fi

compartment_prepare

# Identity. Every line removes a signal at its source, before the agent starts.
# Nothing below inspects or modifies traffic. See docs/DESIGN.md#every-signal-decided.
export LC_ALL=C
export LANG=C
export TZ=UTC
export GIT_AUTHOR_NAME="$P_GIT_NAME"
export GIT_AUTHOR_EMAIL="$P_GIT_EMAIL"
export GIT_COMMITTER_NAME="$P_GIT_NAME"
export GIT_COMMITTER_EMAIL="$P_GIT_EMAIL"
export XDG_CONFIG_HOME="$COMPARTMENT_DIR"
export OPENCODE_CONFIG="$OPENCODE_CONFIG_FILE"
# Config alone is not the compartment. Measured (F9): with only
# XDG_CONFIG_HOME set, the agent still resolved data and state to the shared
# ~/.local/share/calypsocode-agent and ~/.local/state/calypsocode-agent —
# session history and stored credentials would cross between compartments.
# Every signal has to move at the same boundary.
export XDG_DATA_HOME="$COMPARTMENT_DIR/data"
export XDG_STATE_HOME="$COMPARTMENT_DIR/state"
# The profile names the variable rather than holding the key; exporting it by
# that name is the point. Not passed as an argument — argv is world-readable.
# shellcheck disable=SC2163
export "$P_API_KEY_ENV=$API_KEY_VALUE"

# The agent contacts two third parties that are not the provider, by default, on
# every launch: models.dev (hourly, carrying its own product-and-version token) and
# a release endpoint for an update check that can replace the binary. Both leave
# through the same circuit as provider traffic, and the receipt cannot see either —
# Calypso is not in the request path, so it has no way to report them. Refusing them
# here is the only place it can be done.
#
# Belt and braces on purpose: the environment variables are upstream's own opt-outs
# and could be renamed, while `autoupdate` in the generated config is a setting
# upstream has to honour. Neither alone is a guarantee.
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_DISABLE_MODELS_FETCH=1

# There is no Tor to verify in `none` mode; the warning below is the whole
# story there.
if [ "$NETWORK" = "none" ]; then VERIFY=0; fi
export CALYPSO_VERIFY="$VERIFY"

startup_check

# The exit IP is only knowable inside the namespace, and $HOME is the way back
# out (F7). Not /tmp — that is private to the child (F6).
mkdir -p "$STATE_DIR"
EGRESS_FILE="$STATE_DIR/.egress-$$"
STARTED_FILE="$STATE_DIR/.started-$$"
LEAK_FILE="$STATE_DIR/.leak-$$"
rm -f "$EGRESS_FILE" "$STARTED_FILE" "$LEAK_FILE"
export CALYPSO_EGRESS_FILE="$EGRESS_FILE"
export CALYPSO_STARTED_FILE="$STARTED_FILE"
export CALYPSO_LEAK_FILE="$LEAK_FILE"
# Checked here, on the host, and not only inside the namespace: the host-side
# confirmation of leak targets needs curl too, and without it every candidate looks
# unreachable. The user would be told "no target answered" — true, and the wrong
# diagnosis entirely. The inner check stays as well; either alone catches a missing
# curl, and the tests assert the property rather than either line.
if [ "$VERIFY" = "1" ] && ! command -v curl >/dev/null 2>&1; then
  die "curl not found — it is what confirms a leak target answers at all, and what
  proves the egress is Tor. Install it, or accept an unverified session with
  --no-verify."
fi

LEAK_TARGETS="$(leak_targets | tr '\n' ' ')"
export CALYPSO_LEAK_TARGETS="$LEAK_TARGETS"
export CALYPSO_FORCE_UNSAFE="$FORCE_UNSAFE"

# Everything runs inside ONE oniux invocation. The host cannot reach into the
# namespace — no --publish, no port forwarding, nothing (docs/FINDINGS.md F1).
# Any check that has to see the namespace has to run in here.
INNER=$(cat <<'INNER_EOF'
set -euo pipefail

# Duplicated from the launcher on purpose: this runs in a fresh bash inside the
# namespace, so it inherits no functions. Keep the two in step — the host uses it to
# confirm a target answers, this side uses it to prove the same target does not.
#   0 handshake completed · 1 refused · 2 timed out, which is not a pass.
probe_tcp() {
  local rc=0
  (
    unset ALL_PROXY all_proxy HTTP_PROXY http_proxy HTTPS_PROXY https_proxy
    curl -s --noproxy '*' -o /dev/null --max-time "${2:-5}" "http://$1/"
  ) 2>/dev/null || rc=$?
  case "$rc" in
    0 | 52 | 56) return 0 ;;
    28) return 2 ;;
    *) return 1 ;;
  esac
}

if [ "${CALYPSO_VERIFY:-1}" = "1" ]; then
  if ! command -v curl >/dev/null 2>&1; then
    echo "calypsocode: curl not found — it is what proves the egress is Tor and" >&2
    echo "calypsocode: the host's network unreachable." >&2
    echo "calypsocode: install it, or accept an unverified session with --no-verify." >&2
    exit 1
  fi

  # The negative test: attempt what must fail. Every other check here confirms
  # the happy path, and a happy path cannot tell a sealed namespace from a
  # broken one.
  #
  # The proxy is bypassed deliberately. With oniux's ALL_PROXY in place these
  # targets are refused by Tor's SOCKS server (rc=97), which proves the variable
  # is set — not that the route is constrained, which is the actual claim
  # (docs/FINDINGS.md F10).
  leak_targets_in="${CALYPSO_LEAK_TARGETS:-}"
  if [ -z "${leak_targets_in// /}" ]; then
    echo "calypsocode: cannot run the leak test — no target on the host answered a TCP" >&2
    echo "calypsocode: connect from the host itself, so there is nothing whose" >&2
    echo "calypsocode: unreachability from in here would mean anything." >&2
    echo "calypsocode: a test that did not run is not a test that passed." >&2
    exit 1
  fi

  echo "calypsocode: leak test — the host's own network must be unreachable from here." >&2
  leak_reached=""
  leak_unclear=""
  leak_count=0
  leak_rtt=""
  for leak_target in $leak_targets_in; do
    leak_count=$((leak_count + 1))
    leak_t0="$(date +%s%N)"
    # A bare TCP connect, and every outcome is classified rather than lumped into
    # "did not answer". The old test asked for an HTTP page and treated any curl
    # failure as unreachable, so "nothing is listening on port 80" scored as
    # sealed — the same verdict a completely open namespace produces. Only a
    # refused connection proves isolation. A completed handshake is a leak even if
    # nothing useful came back, and a timeout proves nothing either way.
    leak_rc=0
    probe_tcp "$leak_target" 5 || leak_rc=$?
    leak_ms=$(( ( $(date +%s%N) - leak_t0 ) / 1000000 ))
    leak_rtt="$leak_rtt $leak_target=${leak_ms}ms"
    case "$leak_rc" in
      0) leak_reached="$leak_reached $leak_target" ;;
      2) leak_unclear="$leak_unclear $leak_target" ;;
      *) : ;;
    esac
  done

  # Inconclusive is not a pass. A slow host swallowing the connect looks exactly
  # like a sealed namespace, and guessing in the reassuring direction is the bias
  # this whole check exists to avoid.
  if [ -z "$leak_reached" ] && [ -n "$leak_unclear" ]; then
    echo "calypsocode: leak test inconclusive —$leak_unclear timed out rather than" >&2
    echo "calypsocode: refusing the connection, so isolation is neither proved nor" >&2
    echo "calypsocode: disproved. Refusing to launch on a test that cannot answer." >&2
    if [ "${CALYPSO_FORCE_UNSAFE:-0}" = "1" ]; then
      echo "calypsocode: --force-unsafe given — launching anyway. The receipt will say so." >&2
      if [ -n "${CALYPSO_LEAK_FILE:-}" ]; then
        printf 'inconclusive%s\n' "$leak_unclear" > "$CALYPSO_LEAK_FILE"
      fi
    else
      exit 1
    fi
  elif [ -n "$leak_reached" ]; then
    echo "calypsocode: LEAK DETECTED —$leak_reached answered from inside the namespace." >&2
    echo "calypsocode: the compartment is not sealed. Traffic you believed isolated can" >&2
    echo "calypsocode: reach your own network, and the receipt's claims would be false." >&2
    if [ "${CALYPSO_FORCE_UNSAFE:-0}" = "1" ]; then
      echo "calypsocode: --force-unsafe given — launching anyway. The receipt will say so." >&2
      if [ -n "${CALYPSO_LEAK_FILE:-}" ]; then
        printf 'forced%s\n' "$leak_reached" > "$CALYPSO_LEAK_FILE"
      fi
    else
      echo "calypsocode: re-run with --force-unsafe to launch anyway — for debugging" >&2
      echo "calypsocode: isolation, never for work." >&2
      exit 1
    fi
  else
    # "answers from the host" is the load-bearing part of this sentence. The count
    # used to be of targets *probed*, which said nothing, because a target with
    # nothing listening cannot fail the test.
    echo "calypsocode: leak test passed — $leak_count target(s) that answer from the" >&2
    echo "calypsocode: host refused the connection from in here.$leak_rtt" >&2
    if [ -n "${CALYPSO_LEAK_FILE:-}" ]; then
      # count and round-trip times in separate fields; the receipt renders them on
      # separate lines and must not have to guess where one ends.
      printf 'passed %s|%s\n' "$leak_count" "${leak_rtt# }" > "$CALYPSO_LEAK_FILE"
    fi
  fi

  echo "calypsocode: verifying egress from inside the namespace — a few seconds over Tor." >&2

  CALYPSO_EXIT_IP=""
  attempt=1
  while [ "$attempt" -le 3 ]; do
    response="$(curl -s --max-time 60 https://check.torproject.org/api/ip || true)"
    compact="${response// /}"
    case "$compact" in
      *'"IsTor":true'*)
        CALYPSO_EXIT_IP="${compact##*\"IP\":\"}"
        CALYPSO_EXIT_IP="${CALYPSO_EXIT_IP%%\"*}"
        break
        ;;
      *'"IsTor":false'*)
        echo "calypsocode: egress is NOT Tor. Refusing to start the agent." >&2
        echo "calypsocode: the check answered, so traffic left this machine — it just" >&2
        echo "calypsocode: did not go through Tor. Retrying will not fix that." >&2
        exit 1
        ;;
      *)
        echo "calypsocode: attempt $attempt/3 — no usable answer (dead circuit or timeout)." >&2
        ;;
    esac
    attempt=$((attempt + 1))
    if [ "$attempt" -le 3 ]; then sleep 2; fi
  done

  if [ -z "$CALYPSO_EXIT_IP" ]; then
    echo "calypsocode: could not confirm Tor egress in 3 attempts." >&2
    echo "calypsocode: roughly 1 circuit in 3 was dead in testing (docs/FINDINGS.md F4)," >&2
    echo "calypsocode: so this is often worth simply running again." >&2
    exit 1
  fi

  export CALYPSO_EXIT_IP
  if [ -n "${CALYPSO_EGRESS_FILE:-}" ]; then
    printf '%s\n' "$CALYPSO_EXIT_IP" > "$CALYPSO_EGRESS_FILE"
  fi
  echo "calypsocode: egress verified — Tor exit $CALYPSO_EXIT_IP" >&2
else
  echo "calypsocode: WARNING — egress unverified. Nothing here has checked that" >&2
  echo "calypsocode: this session's traffic leaves via Tor." >&2
fi

if ! command -v calypsocode-agent >/dev/null 2>&1; then
  echo "calypsocode: calypsocode-agent not found — build it: github.com/MyrLeProgrammeur/calypsocode-agent" >&2
  exit 127
fi

# Tells the launcher a session actually happened, so it knows whether a
# receipt is owed.
if [ -n "${CALYPSO_STARTED_FILE:-}" ]; then
  : > "$CALYPSO_STARTED_FILE"
fi

exec calypsocode-agent "$@"
INNER_EOF
)

SESSION_START_EPOCH="$(date -u +%s)"
SESSION_START_STAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
SESSION_STARTED=1
# Ctrl-C is how an agent session normally ends. Bash does run the EXIT trap on
# an untrapped SIGINT (measured on 5.3), so the receipt survives either way —
# what these traps buy is the exit status. Without them a signalled launcher
# can exit 0, reporting success for a session the user interrupted.
# RECEIPT_DONE stops the signal path and the EXIT path both writing one.
trap receipt_write EXIT
trap 'receipt_write; exit 130' INT
trap 'receipt_write; exit 143' TERM

STATUS=0
case "$NETWORK" in
  tor)
    command -v oniux >/dev/null 2>&1 \
      || die "oniux not found — cargo install --git https://gitlab.torproject.org/tpo/core/oniux"
    oniux bash -c "$INNER" calypsocode ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"} || STATUS=$?
    ;;
  none)
    echo "calypsocode: WARNING — network 'none'. No isolation: your real IP" >&2
    echo "calypsocode: reaches $P_API_BASE and the compartment covers identity only." >&2
    bash -c "$INNER" calypsocode ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"} || STATUS=$?
    ;;
esac

exit "$STATUS"
