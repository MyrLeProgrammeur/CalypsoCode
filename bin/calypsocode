#!/usr/bin/env bash
# calypsocode — run a coding agent under a compartment identity.
#
# Calypso erases who is asking, not what is asked. Nothing here inspects or
# modifies traffic: every identifier is removed before the agent starts, by
# controlling the environment it runs in.
#
# Design: docs/DESIGN.md · Verified stack behaviour: docs/FINDINGS.md
set -euo pipefail

# Resolved before anything is exported: XDG_CONFIG_HOME is rewritten later to
# point the agent at the compartment, and these paths must not follow it.
CALYPSO_HOME="${CALYPSO_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/calypsocode}"
PROFILE_DIR="${CALYPSO_PROFILE_DIR:-$CALYPSO_HOME/profiles}"

# Keys accepted in a profile file. Anything else is a typo and is refused.
PROFILE_KEYS=(PROFILE NETWORK API_KEY_ENV API_BASE MODEL GIT_NAME GIT_EMAIL)
PROFILE_REQUIRED=(NETWORK API_KEY_ENV API_BASE MODEL GIT_NAME GIT_EMAIL)

PROFILE_FILE=""
COMPARTMENT_DIR=""
OPENCODE_CONFIG_FILE=""

die() { echo "calypsocode: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
calypsocode — run a coding agent under a compartment identity.

usage:
  calypsocode [--profile NAME] [agent args...]
  calypsocode profile [--profile NAME]
  calypsocode doctor
  calypsocode --help

options:
  --profile NAME   compartment to launch (default: default). Resolved to
                   ~/.config/calypsocode/profiles/NAME.env

commands:
  profile          print the resolved profile and exit
  doctor           report what is and is not ready, without launching

environment:
  CALYPSO_NETWORK  override the profile's NETWORK for one run. `none` disables
                   isolation entirely and is warned about on every launch.

Every profile is one namespace, one circuit, one key, one config. Nothing
crosses between compartments — see docs/DESIGN.md.
EOF
}

# --- profile loading -------------------------------------------------------

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

profile_key_known() {
  local k
  for k in "${PROFILE_KEYS[@]}"; do
    if [ "$k" = "$1" ]; then return 0; fi
  done
  return 1
}

# Parses KEY=value lines into P_<KEY> shell variables. The file is read, never
# sourced: a profile lives in a config directory and must not be able to run
# code.
profile_load() {
  local name="$1"
  PROFILE_FILE="$PROFILE_DIR/$name.env"

  if [ ! -f "$PROFILE_FILE" ]; then
    die "profile '$name' not found: $PROFILE_FILE
  → mkdir -p '$PROFILE_DIR' && cp config/profile.example.env '$PROFILE_FILE'
    then edit it, or select another one with --profile NAME."
  fi

  local lineno=0 line key value var
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    line="${line%$'\r'}"
    line="$(trim "$line")"
    case "$line" in
      '' | '#'*) continue ;;
      *=*) ;;
      *) die "$PROFILE_FILE:$lineno: not a KEY=value line: $line" ;;
    esac

    key="$(trim "${line%%=*}")"
    value="$(trim "${line#*=}")"
    case "$value" in
      \"*\") value="${value#\"}"; value="${value%\"}" ;;
      \'*\') value="${value#\'}"; value="${value%\'}" ;;
    esac

    if ! profile_key_known "$key"; then
      die "$PROFILE_FILE:$lineno: unknown key '$key' (accepted: ${PROFILE_KEYS[*]})"
    fi
    printf -v "P_$key" '%s' "$value"
  done < "$PROFILE_FILE"

  for key in "${PROFILE_REQUIRED[@]}"; do
    var="P_$key"
    if [ -z "${!var:-}" ]; then
      die "$PROFILE_FILE: missing required key '$key'"
    fi
  done

  : "${P_PROFILE:=$name}"

  case "$P_NETWORK" in
    tor | none) ;;
    *) die "$PROFILE_FILE: NETWORK='$P_NETWORK' — v1 accepts 'tor' or 'none'" ;;
  esac
}

profile_show() {
  echo "profile:      $P_PROFILE"
  echo "file:         $PROFILE_FILE"
  echo "network:      $P_NETWORK"
  echo "api_base:     $P_API_BASE"
  echo "model:        $P_MODEL"
  echo "git identity: $P_GIT_NAME <$P_GIT_EMAIL>"
  if [ -n "${!P_API_KEY_ENV:-}" ]; then
    echo "api key:      \$$P_API_KEY_ENV is set"
  else
    echo "api key:      \$$P_API_KEY_ENV is NOT set in this shell"
  fi
}

# --- compartment -----------------------------------------------------------

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# The agent config Calypso derives from the profile. Regenerated on every
# launch, because it must always match the profile it claims to implement.
# Anything the user wants to add for this compartment goes in
# $COMPARTMENT_DIR/opencode/opencode.json, which is never written here.
compartment_prepare() {
  COMPARTMENT_DIR="$CALYPSO_HOME/compartments/$P_PROFILE"
  OPENCODE_CONFIG_FILE="$COMPARTMENT_DIR/opencode.calypso.json"

  mkdir -p "$COMPARTMENT_DIR/opencode"

  local base model key_env
  base="$(json_escape "$P_API_BASE")"
  model="$(json_escape "$P_MODEL")"
  key_env="$(json_escape "$P_API_KEY_ENV")"

  cat > "$OPENCODE_CONFIG_FILE" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "calypsocode/$model",
  "provider": {
    "calypsocode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "$(json_escape "$P_PROFILE") (calypsocode compartment)",
      "options": {
        "baseURL": "$base",
        "apiKey": "{env:$key_env}"
      },
      "models": {
        "$model": {}
      }
    }
  }
}
EOF
}

# --- doctor ----------------------------------------------------------------
# Reports what it checked and what it could not check. It does not conclude
# that the tool works: three binaries existing proves nothing, and saying
# otherwise is what the previous version did wrong.

doctor_bin() {
  local name="$1" hint="$2"
  if command -v "$name" >/dev/null 2>&1; then
    echo "  ok    $name — $(command -v "$name")"
    return 0
  fi
  echo "  FAIL  $name not found — $hint"
  return 1
}

doctor() {
  local failed=0

  echo "checked, on this host:"
  doctor_bin oniux    "cargo install --git https://gitlab.torproject.org/tpo/core/oniux" || failed=1
  doctor_bin opencode "curl -fsSL https://opencode.ai/install | bash" || failed=1

  if [ -f "$PROFILE_FILE" ]; then
    echo "  ok    profile '$P_PROFILE' parsed — $PROFILE_FILE"
  fi

  if [ -n "${!P_API_KEY_ENV:-}" ]; then
    echo "  ok    \$$P_API_KEY_ENV is set"
  else
    echo "  FAIL  \$$P_API_KEY_ENV is not set in this shell"
    failed=1
  fi

  echo
  echo "not checked:"
  echo "  egress is Tor — verified from inside the namespace at launch, not here"
  echo "  the provider accepts this key over Tor — untested, see docs/FINDINGS.md"

  echo
  if [ "$failed" = 0 ]; then
    echo "calypsocode: nothing above failed. That is not the same as working —"
    echo "the network claims are verified at launch, not by this command."
  else
    echo "calypsocode: fix the FAIL lines above." >&2
  fi
  return "$failed"
}

# --- argument parsing ------------------------------------------------------

PROFILE_NAME="default"
COMMAND=""
AGENT_ARGS=()

case "${1:-}" in
  doctor | profile)
    COMMAND="$1"
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --profile)
      [ $# -ge 2 ] || die "--profile needs a name"
      PROFILE_NAME="$2"
      shift 2
      ;;
    --profile=*)
      PROFILE_NAME="${1#--profile=}"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      AGENT_ARGS+=("$@")
      break
      ;;
    *)
      AGENT_ARGS+=("$1")
      shift
      ;;
  esac
done

if [ -n "$COMMAND" ] && [ ${#AGENT_ARGS[@]} -gt 0 ]; then
  die "$COMMAND takes no arguments other than --profile"
fi

profile_load "$PROFILE_NAME"

case "$COMMAND" in
  profile)
    profile_show
    exit 0
    ;;
  doctor)
    doctor
    exit $?
    ;;
esac

# --- launch ----------------------------------------------------------------

NETWORK="${CALYPSO_NETWORK:-$P_NETWORK}"
case "$NETWORK" in
  tor | none) ;;
  *) die "CALYPSO_NETWORK='$NETWORK' — accepted values: tor, none" ;;
esac

API_KEY_VALUE="${!P_API_KEY_ENV:-}"
if [ -z "$API_KEY_VALUE" ]; then
  die "\$$P_API_KEY_ENV is empty or unset — this compartment has no key.
  Export it from wherever you keep secrets, then run again."
fi

compartment_prepare

# Identity. Every line removes a signal at its source, before the agent starts.
# Nothing below inspects or modifies traffic. See docs/DESIGN.md#every-signal-decided.
export LC_ALL=C
export LANG=C
export TZ=UTC
export GIT_AUTHOR_NAME="$P_GIT_NAME"
export GIT_AUTHOR_EMAIL="$P_GIT_EMAIL"
export GIT_COMMITTER_NAME="$P_GIT_NAME"
export GIT_COMMITTER_EMAIL="$P_GIT_EMAIL"
export XDG_CONFIG_HOME="$COMPARTMENT_DIR"
export OPENCODE_CONFIG="$OPENCODE_CONFIG_FILE"
# The profile names the variable rather than holding the key; exporting it by
# that name is the point. Not passed as an argument — argv is world-readable.
# shellcheck disable=SC2163
export "$P_API_KEY_ENV=$API_KEY_VALUE"

# Everything runs inside ONE oniux invocation. The host cannot reach into the
# namespace — no --publish, no port forwarding, nothing (docs/FINDINGS.md F1).
# Any check that has to see the namespace has to run in here.
INNER=$(cat <<'INNER_EOF'
set -euo pipefail

if ! command -v opencode >/dev/null 2>&1; then
  echo "calypsocode: opencode not found — curl -fsSL https://opencode.ai/install | bash" >&2
  exit 127
fi

exec opencode "$@"
INNER_EOF
)

STATUS=0
case "$NETWORK" in
  tor)
    command -v oniux >/dev/null 2>&1 \
      || die "oniux not found — cargo install --git https://gitlab.torproject.org/tpo/core/oniux"
    oniux bash -c "$INNER" calypsocode ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"} || STATUS=$?
    ;;
  none)
    echo "calypsocode: WARNING — network 'none'. No isolation: your real IP" >&2
    echo "calypsocode: reaches $P_API_BASE and the compartment covers identity only." >&2
    bash -c "$INNER" calypsocode ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"} || STATUS=$?
    ;;
esac

exit "$STATUS"
