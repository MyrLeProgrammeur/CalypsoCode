#!/usr/bin/env bash
# calypsocode — LEGACY, DOES NOT WORK. Kept for reference only.
#
# This script implements the pre-testing architecture:
#   oniux(litellm proxy) --Tor--> Venice / Tinfoil / other provider
#   opencode --local loopback--> litellm proxy (127.0.0.1)
#
# That architecture is NOT IMPLEMENTABLE. oniux places the proxy in its own
# network namespace, which has its own loopback stack, so a host-side
# opencode can never reach 127.0.0.1:$PROXY_PORT. In `tor` mode this script
# always exhausts its health-check loop and dies with "LiteLLM proxy did not
# start in time". See docs/FINDINGS.md (F1).
#
# Two further defects, both verified:
#   - oniux injects ALL_PROXY=socks5h://localhost:9050, which makes
#     proxy-aware clients tunnel even loopback through Tor, where it is
#     refused. Any same-namespace loopback hop needs NO_PROXY=127.0.0.1
#     (FINDINGS.md F2).
#   - oniux uses a private /tmp by default, so $LOG_FILE is invisible from
#     the host — the failure message above points at a file that does not
#     exist (FINDINGS.md F6).
#
# The replacement design is docs/DESIGN.md (profiles and compartments);
# build order is docs/ROADMAP.md. Do not extend this script — it is to be
# rewritten, not patched.
set -euo pipefail

CONFIG_DIR="${CALYPSO_CONFIG_DIR:-$HOME/.config/calypsocode}"
LITELLM_CONFIG="${CALYPSO_LITELLM_CONFIG:-$CONFIG_DIR/litellm.config.yaml}"
PROXY_PORT="${CALYPSO_PROXY_PORT:-4000}"
NETWORK_MODE="${CALYPSO_NETWORK:-tor}"   # tor | none
REQUIRE_VPN="${CALYPSO_REQUIRE_VPN:-0}"  # 1 = fail if no VPN interface is detected
LOG_FILE="${CALYPSO_LOG_FILE:-/tmp/calypsocode-litellm.log}"

VPN_IFACE_PATTERN='^(proton|wg|tun|nordlynx|mullvad|ipsec)'

die() { echo "calypsocode: $*" >&2; exit 1; }

# --- calypsocode doctor / --check -----------------------------------------
# Checks dependencies without needing API keys or network access.
doctor_check_bin() {
  local name="$1" hint="$2"
  if command -v "$name" >/dev/null 2>&1; then
    echo "  ✓ $name  ($(command -v "$name"))"
    return 0
  fi
  echo "  ✗ $name not found — $hint"
  return 1
}

doctor() {
  local failed=0

  echo "calypsocode doctor — checking dependencies (no API key required)"
  echo
  doctor_check_bin oniux    "see README > Installation (cargo install --git ... oniux)" || failed=1
  doctor_check_bin litellm  "pip install 'litellm[proxy]'" || failed=1
  doctor_check_bin opencode "curl -fsSL https://opencode.ai/install | bash" || failed=1

  echo
  if [ -f "$LITELLM_CONFIG" ]; then
    echo "  ✓ LiteLLM config found: $LITELLM_CONFIG"
  else
    echo "  ✗ LiteLLM config missing: $LITELLM_CONFIG"
    echo "    → cp config/litellm.config.example.yaml $LITELLM_CONFIG, then fill in your keys."
    failed=1
  fi

  echo
  if [ "$failed" = 0 ]; then
    echo "calypsocode: everything is ready."
  else
    echo "calypsocode: at least one dependency is missing — fix the ✗ above before running calypsocode." >&2
  fi
  return "$failed"
}

case "${1:-}" in
  doctor|--check)
    doctor
    exit $?
    ;;
esac

[ -f "$LITELLM_CONFIG" ] || die "config not found: $LITELLM_CONFIG
  → copy config/litellm.config.example.yaml to that location and fill in your keys."

if [ "$REQUIRE_VPN" = "1" ]; then
  ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -Eq "$VPN_IFACE_PATTERN" \
    || die "CALYPSO_REQUIRE_VPN=1 but no recognized VPN interface is active (pattern: $VPN_IFACE_PATTERN).
  Connect your VPN first if you want Tor-over-VPN — oniux then routes on top of the existing default route."
fi

PROXY_PID=""
cleanup() {
  if [ -n "$PROXY_PID" ]; then
    kill "$PROXY_PID" 2>/dev/null
  fi
}
trap cleanup EXIT INT TERM

case "$NETWORK_MODE" in
  tor)
    command -v oniux >/dev/null 2>&1 || die "oniux not found — see README (installation)."
    oniux litellm --config "$LITELLM_CONFIG" --port "$PROXY_PORT" >"$LOG_FILE" 2>&1 &
    PROXY_PID=$!
    ;;
  none)
    echo "calypsocode: WARNING — 'none' mode, no network isolation active." >&2
    litellm --config "$LITELLM_CONFIG" --port "$PROXY_PORT" >"$LOG_FILE" 2>&1 &
    PROXY_PID=$!
    ;;
  *)
    die "invalid CALYPSO_NETWORK: '$NETWORK_MODE' (accepted values: tor, none)"
    ;;
esac

echo "calypsocode: starting proxy (network: $NETWORK_MODE, port $PROXY_PORT)..." >&2
for _ in $(seq 1 40); do
  curl -sf "http://127.0.0.1:${PROXY_PORT}/health/liveliness" >/dev/null 2>&1 && break
  sleep 0.5
done
curl -sf "http://127.0.0.1:${PROXY_PORT}/health/liveliness" >/dev/null 2>&1 \
  || die "LiteLLM proxy did not start in time — see $LOG_FILE"

echo "calypsocode: proxy ready on 127.0.0.1:${PROXY_PORT}, launching OpenCode." >&2

command -v opencode >/dev/null 2>&1 || die "opencode not found — see README (installation)."
exec opencode "$@"
