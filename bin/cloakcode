#!/usr/bin/env bash
# cloakcode — runs OpenCode against a LiteLLM proxy with key rotation,
# that proxy itself being network-isolated (Tor via oniux).
#
# Architecture:
#   oniux(litellm proxy) --Tor--> Venice / Tinfoil / other provider
#   opencode --local loopback--> litellm proxy (127.0.0.1)
#
# See docs/THREAT-MODEL.md before treating anything here as "total
# anonymity" — this script isolates the network, it does not by itself
# handle account identity, payment, or the content of your prompts.
set -euo pipefail

CONFIG_DIR="${CLOAKCODE_CONFIG_DIR:-$HOME/.config/cloakcode}"
LITELLM_CONFIG="${CLOAKCODE_LITELLM_CONFIG:-$CONFIG_DIR/litellm.config.yaml}"
PROXY_PORT="${CLOAKCODE_PROXY_PORT:-4000}"
NETWORK_MODE="${CLOAKCODE_NETWORK:-tor}"   # tor | none
REQUIRE_VPN="${CLOAKCODE_REQUIRE_VPN:-0}"  # 1 = fail if no VPN interface is detected
LOG_FILE="${CLOAKCODE_LOG_FILE:-/tmp/cloakcode-litellm.log}"

VPN_IFACE_PATTERN='^(proton|wg|tun|nordlynx|mullvad|ipsec)'

die() { echo "cloakcode: $*" >&2; exit 1; }

# --- cloakcode doctor / --check -----------------------------------------
# Checks dependencies without needing API keys or network access.
doctor_check_bin() {
  local name="$1" hint="$2"
  if command -v "$name" >/dev/null 2>&1; then
    echo "  ✓ $name  ($(command -v "$name"))"
    return 0
  fi
  echo "  ✗ $name not found — $hint"
  return 1
}

doctor() {
  local failed=0

  echo "cloakcode doctor — checking dependencies (no API key required)"
  echo
  doctor_check_bin oniux    "see README > Installation (cargo install --git ... oniux)" || failed=1
  doctor_check_bin litellm  "pip install 'litellm[proxy]'" || failed=1
  doctor_check_bin opencode "curl -fsSL https://opencode.ai/install | bash" || failed=1

  echo
  if [ -f "$LITELLM_CONFIG" ]; then
    echo "  ✓ LiteLLM config found: $LITELLM_CONFIG"
  else
    echo "  ✗ LiteLLM config missing: $LITELLM_CONFIG"
    echo "    → cp config/litellm.config.example.yaml $LITELLM_CONFIG, then fill in your keys."
    failed=1
  fi

  echo
  if [ "$failed" = 0 ]; then
    echo "cloakcode: everything is ready."
  else
    echo "cloakcode: at least one dependency is missing — fix the ✗ above before running cloakcode." >&2
  fi
  return "$failed"
}

case "${1:-}" in
  doctor|--check)
    doctor
    exit $?
    ;;
esac

[ -f "$LITELLM_CONFIG" ] || die "config not found: $LITELLM_CONFIG
  → copy config/litellm.config.example.yaml to that location and fill in your keys."

if [ "$REQUIRE_VPN" = "1" ]; then
  ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -Eq "$VPN_IFACE_PATTERN" \
    || die "CLOAKCODE_REQUIRE_VPN=1 but no recognized VPN interface is active (pattern: $VPN_IFACE_PATTERN).
  Connect your VPN first if you want Tor-over-VPN — oniux then routes on top of the existing default route."
fi

PROXY_PID=""
cleanup() {
  if [ -n "$PROXY_PID" ]; then
    kill "$PROXY_PID" 2>/dev/null
  fi
}
trap cleanup EXIT INT TERM

case "$NETWORK_MODE" in
  tor)
    command -v oniux >/dev/null 2>&1 || die "oniux not found — see README (installation)."
    oniux litellm --config "$LITELLM_CONFIG" --port "$PROXY_PORT" >"$LOG_FILE" 2>&1 &
    PROXY_PID=$!
    ;;
  none)
    echo "cloakcode: WARNING — 'none' mode, no network isolation active." >&2
    litellm --config "$LITELLM_CONFIG" --port "$PROXY_PORT" >"$LOG_FILE" 2>&1 &
    PROXY_PID=$!
    ;;
  *)
    die "invalid CLOAKCODE_NETWORK: '$NETWORK_MODE' (accepted values: tor, none)"
    ;;
esac

echo "cloakcode: starting proxy (network: $NETWORK_MODE, port $PROXY_PORT)..." >&2
for _ in $(seq 1 40); do
  curl -sf "http://127.0.0.1:${PROXY_PORT}/health/liveliness" >/dev/null 2>&1 && break
  sleep 0.5
done
curl -sf "http://127.0.0.1:${PROXY_PORT}/health/liveliness" >/dev/null 2>&1 \
  || die "LiteLLM proxy did not start in time — see $LOG_FILE"

echo "cloakcode: proxy ready on 127.0.0.1:${PROXY_PORT}, launching OpenCode." >&2

command -v opencode >/dev/null 2>&1 || die "opencode not found — see README (installation)."
exec opencode "$@"
